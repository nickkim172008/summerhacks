rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsAlbum() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    // Albums created before sharing carry no memberIds, so the owner has to be
    // treated as a member on their own album rather than read out of the list.
    function editsAlbum() {
      return ownsAlbum()
             || (signedIn()
                 && request.auth.uid in resource.data.get('memberIds', []));
    }

    function albumMemberIds() {
      return resource.data.get('memberIds', []);
    }

    function albumPendingIds() {
      return resource.data.get('pendingMemberIds', []);
    }

    function nextMemberIds() {
      return request.resource.data.get('memberIds', []);
    }

    function nextPendingIds() {
      return request.resource.data.get('pendingMemberIds', []);
    }

    // An invitee may only move themselves out of pending — either into
    // members (accept) or off the list (decline). Everything else on the
    // album has to stay put so accepting cannot rewrite the collection.
    function albumContentUnchanged() {
      return request.resource.data.name == resource.data.name
             && request.resource.data.placeIds == resource.data.placeIds
             && request.resource.data.get('coverUrl', null)
                == resource.data.get('coverUrl', null);
    }

    function acceptingOwnInvite() {
      return signedIn()
             && request.auth.uid in albumPendingIds()
             && !(request.auth.uid in nextPendingIds())
             && request.auth.uid in nextMemberIds()
             && !(request.auth.uid in albumMemberIds())
             && albumContentUnchanged()
             && nextMemberIds().hasAll(albumMemberIds())
             && nextMemberIds().size() == albumMemberIds().size() + 1
             && albumPendingIds().hasAll(nextPendingIds())
             && albumPendingIds().size() == nextPendingIds().size() + 1;
    }

    function decliningOwnInvite() {
      return signedIn()
             && request.auth.uid in albumPendingIds()
             && !(request.auth.uid in nextPendingIds())
             && nextMemberIds() == albumMemberIds()
             && albumContentUnchanged()
             && albumPendingIds().hasAll(nextPendingIds())
             && albumPendingIds().size() == nextPendingIds().size() + 1;
    }

    function ownsPlace() {
      return signedIn() && resource.data.uploaderId == request.auth.uid;
    }

    // Profiles remain discoverable to authenticated users, but only the
    // account owner can create or edit their profile.
    match /profiles/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && userId == request.auth.uid;
      allow update: if signedIn()
                    && userId == request.auth.uid
                    && request.resource.data.username == resource.data.username;
      allow delete: if signedIn() && userId == request.auth.uid;
    }

    // Username claim documents are immutable locks created by their owner.
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Readable by any signed-in account so profiles and the map can show other
    // people's work — following someone is pointless if their captures are
    // invisible. Writing stays owner-only.
    // Collaborators may fill an album but not take it over: only the owner
    // changes who else is on it, and ownerId is frozen for everyone, so a
    // member cannot promote themselves and then evict the person who made it.
    // Deleting stays with the owner alone.
    match /albums/{albumId} {
      allow create: if signedIn()
                    && request.resource.data.ownerId == request.auth.uid;
      allow read: if signedIn();
      allow delete: if ownsAlbum();
      // Owner manages membership and invites. Members may edit content but
      // not who is on the album. A pending invitee may only accept or decline
      // for themselves — they are not in memberIds yet, so editsAlbum is false.
      allow update: if request.resource.data.ownerId == resource.data.ownerId
                    && (ownsAlbum()
                        || acceptingOwnInvite()
                        || decliningOwnInvite()
                        || (editsAlbum()
                            && nextMemberIds() == albumMemberIds()
                            && nextPendingIds() == albumPendingIds()
                            && request.resource.data.get('memberAddedAt', {})
                               == resource.data.get('memberAddedAt', {})
                            && request.resource.data.get('invitePendingAt', {})
                               == resource.data.get('invitePendingAt', {})));
    }

    match /places/{placeId} {
      allow create: if signedIn()
                    && request.resource.data.uploaderId == request.auth.uid;
      allow read: if signedIn();
      allow delete: if ownsPlace();
      allow update: if ownsPlace()
                    && request.resource.data.uploaderId
                       == resource.data.uploaderId;

      match /audioPins/{pinId} {
        allow read, create, update, delete: if signedIn()
          && get(/databases/$(database)/documents/places/$(placeId)).data.uploaderId
             == request.auth.uid;
      }
    }

    // One doc per follow edge, id "{followerId}_{followingId}". Pinning the id
    // to request.auth.uid is what stops forgery: without it any signed-in
    // client could write edges on other people's behalf and inflate their
    // counts. Self-follows are rejected so a profile cannot pad its own.
    match /follows/{followId} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && followId == request.auth.uid + '_'
                       + request.resource.data.followingId
                    && request.resource.data.followerId == request.auth.uid
                    && request.resource.data.followerId
                       != request.resource.data.followingId;
      allow delete: if signedIn()
                    && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // Deny every collection that has not been explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
