# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local capture leftovers (bytes now live in Firebase Storage)
/splat_*/
/public/splats/

# walkthrough audio — the .wav files under public/audio are committable for the
# same reason, so a shared environment arrives with its sound
/public/audio/*
!/public/audio/*.wav

# local capture inputs
*.mov
*.MOV
