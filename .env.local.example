NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_DEMO_CAPTURE=true

# Where saved captures are stored: "local" writes public/splats/<id>.spz and
# serves it from this app (no bucket, but the file lives on one machine only),
# "firebase" uploads to Cloud Storage and works from anywhere.
NEXT_PUBLIC_SPLAT_STORE=local

# Server-side only. Never prefix with NEXT_PUBLIC_ — it would ship to the browser.
KIRI_API_KEY=

# Pitch mode: capture shows upload → "queued" without calling KIRI (30–90 min).
# Use for demos. Pre-seed albums/environments in Firebase ahead of time.
NEXT_PUBLIC_DEMO_CAPTURE=true
