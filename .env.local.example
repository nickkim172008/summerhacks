NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google Maps JavaScript API (Map tab). Enable it in Google Cloud Console.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Pitch mode: capture accepts the walkthrough without calling KIRI or waiting.
NEXT_PUBLIC_DEMO_CAPTURE=true

# Which engine draws a place. PlayCanvas is the default and is what SuperSplat
# renders with; set to `spark` to put the old three.js path back for a
# side-by-side on the same capture.
NEXT_PUBLIC_SPLAT_RENDERER=playcanvas

# Server-side only. Never prefix with NEXT_PUBLIC_ — it would ship to the browser.
# One key, or several separated by commas. A batch of walkthroughs can outrun
# one account's credits, so submission falls through to the next key when the
# current one is spent. Status and download follow whichever key started a job.
KIRI_API_KEY=

# Points /dev at a splat downloaded by scripts/worldlabs.mjs, so a Marble world
# can be compared against a KIRI one in the same renderer. The script prints the
# value to paste: /dev-splats/<world id>.spz
NEXT_PUBLIC_DEV_SPLAT_URL=

# Server-side only, same rule. World Labs' Marble, being evaluated alongside
# KIRI as the reconstruction backend: platform.worldlabs.ai/api-keys, after a
# payment method and credits. One key — World Labs bills a single balance and
# answers for any world made on it, so there is no pool to fall through.
WORLDLABS_API_KEY=

# Evaluation only: adds W/S/Q/E + Space/Shift movement to the splat viewer, so a
# world that claims to be walkable can be walked. Off in the product.
NEXT_PUBLIC_DEV_FREE_LOOK=

# Multiplies the evaluation flag's movement speed. Default 1, which walks at
# 2 m/s in any capture that reports a metric scale. Raise to cover ground in a
# large scene, lower to inspect something closely.
NEXT_PUBLIC_DEV_MOVE_SPEED=
