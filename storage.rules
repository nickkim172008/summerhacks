rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    // Profile photos: only the owner may write their avatar.
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if signedIn()
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    match /splats/{placeId}/{fileName} {
      allow read: if true;
      allow write: if signedIn();
    }

    // A walkthrough is archived before there is a place to hang it on, so it is
    // filed under the uploader and the moment: videos/{uid}/{ts}/walkthrough.mp4.
    // That is a segment deeper than the others, and a {fileName} match would
    // have covered only videos/{x}/{y} — one segment short, so every upload
    // fell through to deny. The recursive wildcard covers both that shape and
    // the videos/{placeId}/... one that createPlace still writes.
    match /videos/{prefix}/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /audio/{placeId}/{fileName} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}
